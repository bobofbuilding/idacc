{
  "name": "idagents-control-center",
  "productName": "ID Agents Control Center",
  "desktopName": "idagents-control-center.desktop",
  "version": "0.1.689",
  "description": "Unified private AI-agent desktop application with bundled Manager and Brain.",
  "license": "MIT",
  "author": "IDACC Contributors",
  "homepage": "https://github.com/bobofbuilding/idacc",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobofbuilding/idacc.git"
  },
  "private": true,
  "main": "out/main/main.cjs",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.17.x",
    "npm": "10.9.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:integration": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --require-runtime && npm run prepare:notices",
    "start": "npm run build && electron .",
    "dev": "node scripts/build.mjs && electron .",
    "stage:runtimes": "node scripts/stage-unified-runtime.mjs",
    "verify:runtimes": "node ../scripts/verify-runtime-manifest.mjs && node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/runtime-manifest-policy-check.ts resources/idacc-runtime/manifest.json",
    "prepare:notices": "node ../scripts/generate-release-metadata.mjs --notices-only resources/THIRD_PARTY_NOTICES.md",
    "release:metadata": "node ../scripts/generate-release-metadata.mjs",
    "predist": "npm run stage:runtimes",
    "dist": "npm run build:release && electron-builder --dir",
    "release:mac": "node scripts/release-preflight.mjs --platform mac --require-signing && npm run stage:runtimes && npm run build:release && node scripts/run-production-builder.mjs --platform mac -- --mac dmg zip --publish never",
    "release:win": "node scripts/release-preflight.mjs --platform win --require-signing && npm run stage:runtimes && npm run build:release && node scripts/run-production-builder.mjs --platform win -- --win nsis --publish never",
    "release:linux": "node scripts/release-preflight.mjs --platform linux && npm run stage:runtimes && npm run build:release && node scripts/run-production-builder.mjs --platform linux -- --linux AppImage deb --publish never",
    "dmg": "npm run release:mac",
    "typecheck": "tsc --noEmit",
    "test:app-shutdown": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/app-shutdown-coordinator-smoke.ts",
    "test:computer-use-shutdown": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/computer-use-shutdown-smoke.ts",
    "test:windows-native-toolchain": "node scripts/build.mjs --probe-windows-native-toolchain",
    "test:windows-job-host": "node scripts/windows-job-host-integration-smoke.mjs",
    "test:chat-failure": "node scripts/chat-terminal-failure-smoke.mjs",
    "test:background-policy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/background-policy-smoke.mjs",
    "test:release-payload": "node ../scripts/release-payload-smoke.mjs",
    "test:release-provenance": "node ../scripts/release-provenance-smoke.mjs",
    "test:runtime-source-capsule": "node ../scripts/runtime-source-capsule-smoke.mjs",
    "test:appimage-artifact": "node ../scripts/appimage-artifact-verifier-smoke.mjs",
    "test:deb-artifact": "node ../scripts/deb-artifact-verifier-smoke.mjs",
    "test:release-platform-config": "node scripts/release-platform-config-smoke.mjs",
    "test:review-build-workflow": "node ../scripts/review-build-workflow-smoke.mjs",
    "test:release-build-output": "node scripts/release-build-smoke.mjs",
    "test:release-preflight": "node scripts/release-preflight-smoke.mjs",
    "test:unified-stack": "node ../scripts/unified-stack-release-smoke.mjs \"release/mac-arm64/ID Agents Control Center.app\"",
    "test:unified-stack-policy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/unified-stack-supervisor-smoke.mjs",
    "test:unified-stack-integration": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/unified-stack-supervisor-integration.mjs",
    "test:unified-runtime-contract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/unified-runtime-contract-smoke.ts",
    "test:runtime-profile-isolation": "node ../idctl/node_modules/tsx/dist/cli.mjs scripts/runtime-profile-isolation-smoke.ts",
    "test:release-cleanup": "node ../scripts/release-artifact-cleanup-smoke.mjs",
    "test:release-published": "node ../scripts/release-published-smoke.mjs",
