{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDACC Interface Simulation (Developer Only)",
  "version": "0.0.0",
  "identifier": "world.idchain.idacc-interface-simulation",
  "build": {
    "frontendDist": "../dist-tauri",
    "beforeBuildCommand": "node scripts/build-tauri.mjs",
    "beforeDevCommand": "node scripts/build-tauri.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "IDACC Interface Simulation (Developer Only)",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "DeveloperTool",
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
